# Server Configuration
PORT=3000
NODE_ENV=development

# OpenRouter API (https://openrouter.ai/keys)
# Dang ky tai openrouter.ai -> Keys -> Create Key
# Mot key de goi GPT-4o, Claude 3.5, Gemini 2.0, DeepSeek va 200+ model khac
# Format: sk-or-v1-...
OPENROUTER_API_KEY=your_openrouter_api_key_here

# EmailJS (https://www.emailjs.com) - 200 email/thang mien phi
# 1. Dang ky tai emailjs.com
# 2. Email Services -> Add New Service (Gmail/Outlook) -> lay Service ID
# 3. Email Templates -> Create Template -> lay Template ID
# 4. Account -> API Keys -> lay Public Key
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
CONTACT_EMAIL=your_contact_email_here

# TCBS iFlash OpenAPI (https://tcinvest.tcbs.com.vn/iflash-open-api)
# Dang ky tai tcinvest.tcbs.com.vn -> iFlash OpenAPI -> lay API Key
TCBS_API_KEY=your-tcbs-api-key-here
TCBS_API_BASE=https://openapi.tcbs.com.vn
TCBS_WS_URL=wss://openapi.tcbs.com.vn/ws/thesis/v1/stream/normal

# DNSE Open API / Entrade X (https://www.dnse.com.vn)
# Dang ky tai dnse.com.vn -> Open API -> lay API Key / JWT Token
DNSE_API_KEY=your_dnse_jwt_key_here
DNSE_API_BASE=https://api.dnse.com.vn
DNSE_ENTRADE_BASE=https://services.entrade.com.vn
DNSE_WS_URL=wss://datafeed-lts.dnse.com.vn/wss

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
